# Optimike Obsidian MCP - dedicated headless server profile
# Copy to your service environment. Do not commit real secrets.

OBSIDIAN_RUNTIME_MODE=headless-readonly
OBSIDIAN_VAULT=/srv/obsidian/optimike-server-vault
OBSIDIAN_CACHE_SOURCE=filesystem
OBSIDIAN_ENABLE_CACHE=true
OBSIDIAN_SHARED_CACHE_DB_PATH=/var/lib/optimike-obsidian-mcp/shared-cache.sqlite
# Optional absolute machine-local path. Never place the sealed-plan journal in
# a synchronized vault or in distributable vault content.
MCP_OBSIDIAN_NOTE_REPLACE_JOURNAL_PATH=/var/lib/optimike-obsidian-mcp/obsidian-note-replace.sqlite
# Optional crash-detection lease. Default: 30000 ms. Shorter values recover
# sooner after a crash but tolerate less event-loop or filesystem delay.
MCP_OBSIDIAN_NOTE_REPLACE_EXECUTION_LEASE_MS=30000
OBSIDIAN_VAULT_EXCLUDE_PATTERNS=tmp/**,**/tmp/**,.git/**,.obsidian/plugins/**,**/*.sqlite,**/*.sqlite-*,logs/**,screenshots/**

# Local stdio is the lowest-friction default.
MCP_TRANSPORT_TYPE=stdio
MCP_WRITE_MODE=readonly
MCP_LOG_LEVEL=info
SEMANTIC_SEARCH_PREWARM=false

# Streamable HTTP profile. Uncomment and provision secrets outside Git.
# MCP_TRANSPORT_TYPE=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3010
# MCP_AUTH_MODE=jwt
# MCP_AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
# MCP_ALLOWED_ORIGINS=
#
# Functional quota, keyed by verified issuer/client_id/subject rather than IP.
# MCP_HTTP_IDENTITY_RATE_LIMIT_WINDOW_MS=900000
# MCP_HTTP_IDENTITY_RATE_LIMIT_MAX=100
# MCP_HTTP_IDENTITY_RATE_LIMIT_MAX_KEYS=10000
#
# Independent pre-authentication source-IP protection.
# MCP_HTTP_PREAUTH_RATE_LIMIT_WINDOW_MS=900000
# MCP_HTTP_PREAUTH_RATE_LIMIT_MAX=600
# MCP_HTTP_PREAUTH_RATE_LIMIT_MAX_KEYS=5000
# MCP_HTTP_LOOPBACK_POLICY=elevated
# MCP_HTTP_LOOPBACK_PREAUTH_RATE_LIMIT_MAX=3000
# MCP_HTTP_RATE_LIMIT_CLEANUP_INTERVAL_MS=300000
# MCP_HTTP_MAX_SESSIONS=500
# MCP_HTTP_SESSION_IDLE_TIMEOUT_MS=1800000
# MCP_HTTP_SESSION_MAX_LIFETIME_MS=86400000
# MCP_HTTP_SESSION_CLEANUP_INTERVAL_MS=60000
# MCP_HTTP_MAX_REQUEST_BODY_BYTES=1048576
# MCP_HTTP_REQUEST_BODY_READ_TIMEOUT_MS=5000
#
# Empty means Forwarded and X-Forwarded-For are ignored. Add only immediate,
# authenticated proxy IPs/CIDRs. If both header families are present, the
# request falls back to the socket address. Never use MCP_TRUST_PROXY=true alone.
# MCP_TRUSTED_PROXIES=10.20.0.10/32,2001:db8:42::10/128
#
# Optional dedicated HMAC key for pseudonymous identity and source-address keys.
# When omitted, the JWT secret or a process-local random key is used.
# MCP_HTTP_IDENTITY_HASH_KEY=replace-with-at-least-32-random-characters
#
# A stdio proxy connected to a secured shared backend needs a verified bearer.
# Provision one credential per agent for isolated quotas. Reusing a credential
# intentionally shares quotas and session admission identity.
# MCP_BACKEND_BEARER_TOKEN=replace-with-agent-specific-token

# Cache/snapshot age after which readiness reports stale provenance.
# MCP_OBSERVABILITY_STALE_AFTER_MS=900000

# Optional: absolute machine-local JSON file defining bounded external roots.
# The file itself must not be committed.
MCP_EXTERNAL_ROOTS_FILE=/etc/optimike-obsidian-mcp/external-roots.json

# Operon reads may use the last validated snapshot in headless mode.
# Apply always requires live Obsidian plus both explicit mutation opt-ins.
OPERON_MUTATIONS_ENABLED=false
OPERON_MUTATION_ALLOWED_PATH_PREFIXES=

# Long-run validation knobs.
HEADLESS_SERVER_VAULT=/srv/obsidian/optimike-server-vault
HEADLESS_SERVER_CACHE_DIR=/var/lib/optimike-obsidian-mcp
HEADLESS_LONG_RUN_MINUTES=120
HEADLESS_LONG_RUN_INTERVAL_SECONDS=60
HEADLESS_LONG_RUN_OUTPUT_DIR=.tmp/headless-long-run
