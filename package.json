{
  "name": "optimike-obsidian-mcp",
  "version": "2.0.7",
  "description": "Unified Obsidian MCP server with shared local cache, integrated Tasks tools, Bases support, semantic search via Smart Connections, server health/status observability, and degraded read mode for durable Codex workflows.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "OPERATIONS.md",
    "OPERATIONS.fr.md",
    "docs/runtime-capability-matrix.md",
    "docs/runtime-capability-matrix.fr.md",
    "docs/headless-server-profile.md",
    "docs/headless-server-profile.fr.md",
    "docs/assets",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "optimike-obsidian-mcp": "dist/index.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optimikelabs/optimike-obsidian-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/optimikelabs/optimike-obsidian-mcp/issues"
  },
  "homepage": "https://github.com/optimikelabs/optimike-obsidian-mcp#readme",
  "scripts": {
    "build": "tsc && node scripts/make-executable.mjs dist/index.js dist/stdio-proxy.js",
    "start:stdio": "node dist/index.js",
    "start:proxy": "node dist/stdio-proxy.js",
    "inspect": "DANGEROUSLY_OMIT_AUTH=true npx @modelcontextprotocol/inspector --open",
    "start": "node dist/index.js",
    "start:http": "MCP_LOG_LEVEL=debug MCP_TRANSPORT_TYPE=http node dist/index.js",
    "start:daemon": "MCP_LOG_LEVEL=debug MCP_TRANSPORT_TYPE=http node dist/index.js",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:headless-readonly": "node scripts/smoke-headless-readonly.mjs",
    "smoke:hybrid-unavailable": "node scripts/smoke-headless-readonly.mjs --mode=hybrid",
    "smoke:hybrid-api-available": "node scripts/smoke-headless-readonly.mjs --mode=hybrid-live",
    "smoke:headless-guarded": "node scripts/smoke-headless-readonly.mjs --mode=headless-guarded",
    "smoke:headless-status": "node scripts/smoke-headless-status.mjs",
    "smoke:headless-server-profile": "node scripts/smoke-headless-server-profile.mjs",
    "check:vault-exclusions": "node scripts/check-vault-exclusion-policy.mjs",
    "test:runtime": "npm run build && npm run smoke:headless-readonly && npm run smoke:hybrid-unavailable && npm run smoke:hybrid-api-available && npm run smoke:headless-guarded && npm run smoke:headless-status",
    "verify:code": "npm audit && npm run build",
    "rebuild": "npx ts-node --esm scripts/clean.ts && npm run build",
    "fetch:spec": "npx ts-node --esm scripts/fetch-openapi-spec.ts",
    "docs:generate": "typedoc --tsconfig ./tsconfig.typedoc.json",
    "tree": "npx ts-node --esm scripts/tree.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,css}\"",
    "inspect:stdio": "mcp-inspector --config mcp.json --server optimike-obsidian-mcp-stdio",
    "inspect:http": "mcp-inspector --config mcp.json --server optimike-obsidian-mcp-http"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/validator": "^13.15.10",
    "axios": "^1.16.0",
    "chrono-node": "2.8.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "hono": "^4.12.18",
    "ignore": "^7.0.5",
    "jose": "^6.0.11",
    "js-yaml": "^4.1.0",
    "json5": "^2.2.3",
    "openai": "^5.6.0",
    "partial-json": "^0.1.7",
    "sanitize-html": "^2.17.0",
    "tiktoken": "^1.0.21",
    "validator": "^13.15.35",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0",
    "zod": "^3.25.67"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "obsidian-md",
    "ai",
    "llm",
    "agent",
    "automation",
    "api",
    "server",
    "typescript",
    "knowledge-management",
    "note-taking",
    "rest-api",
    "integration"
  ],
  "author": "Optimike (Mickael Ahouansou)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.7.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.5",
    "typescript": "^5.6.0"
  }
}
