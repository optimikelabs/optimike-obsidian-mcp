# Bounded concurrent admission for Streamable HTTP.
# Copy selected values into the service environment. No secret belongs here.

MCP_HTTP_MAX_IN_FLIGHT=32
MCP_HTTP_MAX_IN_FLIGHT_PER_IDENTITY=8
MCP_HTTP_EXPENSIVE_MAX_IN_FLIGHT=4
MCP_HTTP_EXPENSIVE_MAX_IN_FLIGHT_PER_IDENTITY=2
MCP_HTTP_MUTATION_MAX_IN_FLIGHT=4
MCP_HTTP_MUTATION_MAX_IN_FLIGHT_PER_IDENTITY=1
MCP_HTTP_MAX_QUEUED=64
MCP_HTTP_MAX_QUEUED_PER_IDENTITY=8
MCP_HTTP_QUEUE_WAIT_TIMEOUT_MS=5000
MCP_HTTP_MAX_REQUEST_BODY_BYTES=1048576
MCP_HTTP_REQUEST_BODY_READ_TIMEOUT_MS=5000
MCP_HTTP_BACKPRESSURE_RETRY_AFTER_SECONDS=1

# Exact registered tool names only. Unknown names remain standard operations.
MCP_HTTP_EXPENSIVE_TOOLS=smart_semantic_search,smart_search,smart-search,obsidian_runtime_maintenance,obsidian_global_search,bases_query,list_all_tasks,query_tasks,operon_get_configuration,operon_validate,external_read,external_handoff
MCP_HTTP_MUTATION_TOOLS=obsidian_update_note,obsidian_search_replace,obsidian_delete_note,obsidian_manage_frontmatter,obsidian_batch_frontmatter,obsidian_manage_tags,obsidian_manage_canvas,obsidian_admin_filesystem,obsidian_move_note,bases_create,bases_upsert_config,bases_upsert_rows,operon_adopt_task,operon_create_task,operon_update_task,operon_transition_task,operon_set_relationships,operon_update_recurrence,operon_convert_task,operon_relocate_task,operon_recover_mutation
